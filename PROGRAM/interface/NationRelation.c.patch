#replacewith
	// Nova Nacao: tabela gerada por laco para MAX_NATIONS (antes era 5x5 escrita a mao)
	int WidthIcons = 52;
	int HeightIcons = 52;
	string OffsetIcons = "4,6";
	int i, j;
	string sRow, sCol;

	GameInterface.TABLE_NATIONS.hr.td1.str = "";
	GameInterface.TABLE_NATIONS.hr.td1.scale = 0.0;
	for (j = 0; j < MAX_NATIONS; j++)
	{
		sCol = "td" + (j + 2);
		GameInterface.TABLE_NATIONS.hr.(sCol).icon.group = "NATIONS";
		GameInterface.TABLE_NATIONS.hr.(sCol).icon.image = Nations[j].Name;
		GameInterface.TABLE_NATIONS.hr.(sCol).icon.width = WidthIcons;
		GameInterface.TABLE_NATIONS.hr.(sCol).icon.height = HeightIcons;
		GameInterface.TABLE_NATIONS.hr.(sCol).icon.offset = OffsetIcons;
	}

	for (i = 0; i < MAX_NATIONS; i++)
	{
		sRow = "tr" + (i + 1);
		GameInterface.TABLE_NATIONS.(sRow).td1.icon.group = "NATIONS";
		GameInterface.TABLE_NATIONS.(sRow).td1.icon.image = Nations[i].Name;
		GameInterface.TABLE_NATIONS.(sRow).td1.icon.width = WidthIcons;
		GameInterface.TABLE_NATIONS.(sRow).td1.icon.height = HeightIcons;
		GameInterface.TABLE_NATIONS.(sRow).td1.icon.offset = OffsetIcons;

		for (j = 0; j < MAX_NATIONS; j++)
		{
			sCol = "td" + (j + 2);
			if (i == j)
			{
				GameInterface.TABLE_NATIONS.(sRow).(sCol).str = "";
				GameInterface.TABLE_NATIONS.(sRow).(sCol).scale = 0.0;
				continue;
			}
			GameInterface.TABLE_NATIONS.(sRow).(sCol).icon.group = "RELATIONS";
			GameInterface.TABLE_NATIONS.(sRow).(sCol).icon.image = GetRelationName(GetNationRelation(i, j));
			GameInterface.TABLE_NATIONS.(sRow).(sCol).icon.width = WidthIcons;
			GameInterface.TABLE_NATIONS.(sRow).(sCol).icon.height = HeightIcons;
			GameInterface.TABLE_NATIONS.(sRow).(sCol).icon.offset = OffsetIcons;
		}
	}
}

