// Nova Nacao: a cada 20 dias, um boato sobre Portugal (metade nas colonias portuguesas, metade fora delas)
void Portugal_RumourTick()
{
	if (CheckAttribute(pchar, "questTemp.PorRumour.control_year"))
	{
		if (GetQuestPastDayParam("questTemp.PorRumour") < 20) return;
	}
	SaveCurrentQuestDateParam("questTemp.PorRumour");
	int i = rand(19);
	int iKey = 2111 + i;
	if (i >= 10) iKey = 2112 + i; // 2121 e a mensagem de mundo liberado
	string sKey = "Diplomat_dialog_" + iKey;
	bool bHome = false;
	if (i < 5) bHome = true;
	if (i >= 10 && i < 15) bHome = true;
	if (bHome) AddSimpleRumour(StringFromKey(sKey), PORTUGAL, 30, 3);
	else AddSimpleRumour(StringFromKey(sKey), PORTUGAL + 10, 30, 3);
}

// Nova Nacao: Cumana e Caracas nao sao cercadas durante a linha de missoes de Portugal
bool Portugal_ColonyProtected(string sColony)
{
	if (sColony != "Cumana" && sColony != "Caracas") return false;
	if (!CheckAttribute(pchar, "questTemp.PorLine")) return false;
	string sSt = pchar.questTemp.PorLine;
	if (sSt == "" || sSt == "done") return false;
	return true;
}

// Nova Nacao: troca o modelo dos governadores de Cumana e Caracas (faixa espanhola -> portuguesa) em saves antigos
void Portugal_FixMayorModels()
{
	Portugal_SetResidenceTextures();
	POR_BF_Tick(); // Nova Nacao: Frota do Brasil
	POR_GG_FixSecPos(); // Nova Nacao: secretario ao lado do governador em Caracas
	Portugal_FixOneMayor("Caracas_Mayor", "huber_21", "huber_por21");
	Portugal_FixOneMayor("Cumana_Mayor", "huber_26", "huber_por26");
	Portugal_FixOneMayor("POR_Rep", "huber_0", "huber_por0");
	Portugal_FixCapturedMayors();
	Portugal_CheckLineEnd();
}

// Nova Nacao: azulejos nas residencias de Cumana e Caracas (pasta de texturas so dessas duas; o resto cai na pasta comum)
void Portugal_SetResidenceTextures()
{
	int i = FindLocation("Cumana_townhall");
	if (i >= 0) Locations[i].filespath.textures = "PortugalRes\Cumana";
	i = FindLocation("Caracas_townhall");
	if (i >= 0) Locations[i].filespath.textures = "PortugalRes\Caracas";
}

void Portugal_FixOneMayor(string sId, string sOld, string sNew)
{
	int i = GetCharacterIndex(sId);
	if (i < 0) return;
	if (Characters[i].model != sOld) return;
	Characters[i].model = sNew;
	if (IsEntity(&Characters[i])) Characters_RefreshModel(&Characters[i]);
}

string Portugal_GovPoolItem(int k)
{
	string sM = "huber_por21";
	if (k == 0) sM = "huber_por19";
	if (k == 1) sM = "huber_por20";
	if (k == 2) sM = "huber_por21";
	if (k == 3) sM = "huber_por26";
	if (k == 4) sM = "huber_2";
	if (k == 5) sM = "huber_18";
	if (k == 6) sM = "huber_24";
	return sM;
}

bool Portugal_ModelInUse(string sM)
{
	int n;
	for (n = 0; n < MAX_CHARACTERS; n++)
	{
		if (!CheckAttribute(&Characters[n], "model")) continue;
		if (Characters[n].model == sM) return true;
	}
	return false;
}

string Portugal_GovModel()
{
	int iStart = rand(6);
	int k, j;
	string sM;
	for (k = 0; k < 7; k++)
	{
		j = iStart + k;
		if (j >= 7) j = j - 7;
		sM = Portugal_GovPoolItem(j);
		if (!Portugal_ModelInUse(sM)) return sM;
	}
	sM = Portugal_GovPoolItem(iStart);
	return sM;
}

void Portugal_FixCapturedMayors()
{
	int i, iChar;
	string sM;
	for (i = 0; i < MAX_COLONIES; i++)
	{
		if (!CheckAttribute(&colonies[i], "nation")) continue;
		if (sti(colonies[i].nation) != PORTUGAL) continue;
		iChar = GetCharacterIndex(colonies[i].id + "_Mayor");
		if (iChar < 0) continue;
		if (!CheckAttribute(&Characters[iChar], "model")) continue;
		sM = Characters[iChar].model;
		if (findsubstr(sM, "usurer_", 0) != 0 && findsubstr(sM, "portman_", 0) != 0) continue;
		Characters[iChar].model = Portugal_GovModel();
		FaceMaker(&Characters[iChar]);
		if (IsEntity(&Characters[iChar])) Characters_RefreshModel(&Characters[iChar]);
	}
}

// saves em que a linha de Portugal ja terminou: liberar o mundo vivo como no fim das linhas das nacoes
void Portugal_CheckLineEnd()
{
	if (!bWorldAlivePause) return;
	if (!CheckAttribute(pchar, "questTemp.PorLine")) return;
	if (pchar.questTemp.PorLine != "done") return;
	bWorldAlivePause = false;
	Log_Info(StringFromKey("Diplomat_dialog_2121"));
}

