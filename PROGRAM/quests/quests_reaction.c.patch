// Nova Nacao: hastear a bandeira de Portugal
void Flag_PORTUGAL()
{
	PChar.nation = PORTUGAL;
	Ship_FlagRefresh(PChar); //флаг на лету
	SetNationToOfficers(PORTUGAL);

	SetNationRelation2MainCharacter(ENGLAND, GetNationRelation(ENGLAND, PORTUGAL));
	SetNationRelation2MainCharacter(FRANCE, GetNationRelation(FRANCE, PORTUGAL));
	SetNationRelation2MainCharacter(SPAIN, GetNationRelation(SPAIN, PORTUGAL));
	SetNationRelation2MainCharacter(PIRATE, RELATION_ENEMY);
	SetNationRelation2MainCharacter(HOLLAND, GetNationRelation(PORTUGAL, HOLLAND));

	SetNationRelation2MainCharacter(PORTUGAL, RELATION_FRIEND);

	LAi_group_SetRelation("PORTUGAL_CITIZENS", LAI_GROUP_PLAYER, LAI_GROUP_NEITRAL);
	
	LAi_group_ClearAllTargets();
#endreplace

#find
	SetNationRelation2MainCharacter(HOLLAND, RELATION_FRIEND);

	LAi_group_SetRelation("HOLLAND_CITIZENS", LAI_GROUP_PLAYER, LAI_GROUP_NEITRAL);
#replacewith
	SetNationRelation2MainCharacter(HOLLAND, RELATION_FRIEND);

	SetNationRelation2MainCharacter(PORTUGAL, GetNationRelation(HOLLAND, PORTUGAL)); // Nova Nacao

	LAi_group_SetRelation("HOLLAND_CITIZENS", LAI_GROUP_PLAYER, LAI_GROUP_NEITRAL);
#endreplace

#find
		case HOLLAND:    Flag_HOLLAND();    break;
#replacewith
		case HOLLAND:    Flag_HOLLAND();    break;
		case PORTUGAL:    Flag_PORTUGAL();    break; // Nova Nacao
#endreplace
